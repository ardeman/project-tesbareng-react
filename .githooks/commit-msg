#!/bin/sh
# Enforce Conventional Commits (https://www.conventionalcommits.org).
# Installed by `npm install` (prepare script sets core.hooksPath=.githooks).

msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed -n '/./{p;q;}')

# Let git-generated messages through.
case "$subject" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject is not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo "" >&2
  echo "Expected: <type>(<optional scope>)!: <description>" >&2
  echo "Types: $(echo $types | tr '|' ' ')" >&2
  echo "Example: feat(cohort): add ring assignment RPC" >&2
  exit 1
fi

if [ ${#subject} -gt 100 ]; then
  echo "commit-msg: subject is longer than 100 characters (${#subject})." >&2
  exit 1
fi
