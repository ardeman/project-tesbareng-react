# Copy to web/.env.local for a non-default target, or set these in the Vercel project settings.
# With nothing set, the app talks to the local Supabase stack (npm run db:start).
# Project URL and the public "anon" key: Supabase dashboard, Project Settings, API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
